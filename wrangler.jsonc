{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mangofanfan",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB_COMMENT",
      "database_id": "531529fc-b381-46f3-a596-6eeb02bd7716"
    }
  ]
}

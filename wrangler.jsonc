{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mangofanfan",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "531529fc-b381-46f3-a596-6eeb02bd7716",
      "migrations_table": "_hub_migrations",
      "migrations_dir": "server/db/migrations/sqlite/"
    }
  ],
  "vars": {
    "NUXT_HUB_CLOUDFLARE_ACCOUNT_ID": "957be19c706ca2e85429d0e436a2cfa5",
    "NUXT_HUB_CLOUDFLARE_DATABASE_ID": "531529fc-b381-46f3-a596-6eeb02bd7716"
  }
}
